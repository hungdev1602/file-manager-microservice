# Tải thư viện từ registry.npmjs.org (kho gốc của npm) thay cho registry.yarnpkg.com:
# một số mạng (nhà mạng, wifi) bị ngắt kết nối tới registry.yarnpkg.com, yarn install báo "ECONNRESET"
registry "https://registry.npmjs.org"

# Chờ tối đa 10 phút cho mỗi lần tải (thư viện thu nhỏ ảnh sharp cho Windows nặng khoảng 8 MB, mạng chậm vẫn tải được)
network-timeout 600000
